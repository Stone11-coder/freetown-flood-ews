from pathlib import Path

project_dir = Path.home() / "freetown_flood_project"

print("PROJECT FOLDERS")
for folder in [
    project_dir / "notebooks",
    project_dir / "data" / "raw",
    project_dir / "data" / "processed",
]:
    print(f"\n{folder}")
    if folder.exists():
        for item in sorted(folder.iterdir()):
            print("  ", item.name)
    else:
        print("   Folder does not exist")

print("\nALL NOTEBOOKS IN PROJECT")
for notebook in project_dir.rglob("*.ipynb"):
    print(notebook.relative_to(project_dir))




